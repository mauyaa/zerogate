{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zerogate.dev/stored-ledger-event/1.0.0",
  "title": "ZeroGate Stored Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "sequence",
    "datacontenttype",
    "data",
    "previousHash",
    "eventHash"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri-reference" },
    "type": { "type": "string", "pattern": "^dev\\.zerogate\\.[a-z0-9_.-]+\\.v[0-9]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1 },
    "traceparent": { "type": "string" },
    "causationId": { "type": "string" },
    "correlationId": { "type": "string" },
    "datacontenttype": { "const": "application/json" },
    "data": { "type": "object" },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
