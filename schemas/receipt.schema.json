{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zerogate.dev/receipt/1.0.0",
  "title": "ZeroGate Transaction Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "transactionId",
    "issuedAt",
    "finalStatus",
    "finality",
    "intentBinding",
    "actions",
    "approvals",
    "manualRecovery",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "receiptId": { "type": "string", "format": "uuid" },
    "transactionId": { "type": "string", "format": "uuid" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "finalStatus": {
      "type": "string",
      "enum": [
        "VERIFIED_COMMITTED",
        "VERIFIED_COMPENSATED",
        "MANUAL_RECOVERY_REQUIRED",
        "APPROVAL_DENIED",
        "PREFLIGHT_FAILED",
        "ABORTED",
        "EXPIRED"
      ]
    },
    "finality": { "$ref": "#/$defs/finality" },
    "intentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "environment",
        "actor",
        "purpose",
        "resourceScope",
        "expiresAt",
        "limitsHash",
        "actionSetRoot",
        "policyVersion"
      ],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "string",
          "enum": ["development", "test", "staging", "production"]
        },
        "actor": { "$ref": "#/$defs/actor" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "resourceScope": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resourceScope" }
        },
        "expiresAt": { "type": "string", "format": "date-time" },
        "limitsHash": { "$ref": "#/$defs/canonicalHash" },
        "actionSetRoot": { "$ref": "#/$defs/canonicalHash" },
        "policyVersion": { "type": "string", "minLength": 1 }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "operation",
          "logicalOperationId",
          "payloadHash",
          "contractDigest",
          "status",
          "finality",
          "attemptIds",
          "providerRequestIds",
          "observations",
          "residualRisk"
        ],
        "properties": {
          "actionId": { "type": "string", "format": "uuid" },
          "operation": { "type": "string", "minLength": 1 },
          "logicalOperationId": { "type": "string", "minLength": 1 },
          "payloadHash": { "$ref": "#/$defs/canonicalHash" },
          "contractDigest": { "$ref": "#/$defs/canonicalHash" },
          "status": { "$ref": "#/$defs/actionState" },
          "finality": { "$ref": "#/$defs/finality" },
          "attemptIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "providerRequestIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "observations": { "type": "array", "items": { "type": "object" } },
          "recovery": { "type": "object" },
          "residualRisk": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mandate", "publicKeyPem", "keyId", "consumedAt"],
        "properties": {
          "mandate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claims", "algorithm", "keyId", "signature"],
            "properties": {
              "claims": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approvalId",
                  "nonce",
                  "transactionId",
                  "actor",
                  "approverId",
                  "approvalLevel",
                  "actionSetRoot",
                  "payloadHash",
                  "contractDigest",
                  "resourceWitnessHash",
                  "limitsHash",
                  "policyVersion",
                  "expiresAt",
                  "issuedAt"
                ],
                "properties": {
                  "approvalId": { "type": "string", "format": "uuid" },
                  "nonce": { "type": "string", "format": "uuid" },
                  "transactionId": { "type": "string", "format": "uuid" },
                  "actor": { "$ref": "#/$defs/actor" },
                  "approverId": { "type": "string", "minLength": 1 },
                  "approvalLevel": { "type": "string", "minLength": 1 },
                  "actionSetRoot": { "$ref": "#/$defs/canonicalHash" },
                  "payloadHash": { "$ref": "#/$defs/canonicalHash" },
                  "contractDigest": { "$ref": "#/$defs/canonicalHash" },
                  "resourceWitnessHash": { "$ref": "#/$defs/canonicalHash" },
                  "limitsHash": { "$ref": "#/$defs/canonicalHash" },
                  "policyVersion": { "type": "string", "minLength": 1 },
                  "expiresAt": { "type": "string", "format": "date-time" },
                  "issuedAt": { "type": "string", "format": "date-time" }
                }
              },
              "algorithm": { "const": "Ed25519" },
              "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{24}$" },
              "signature": { "type": "string", "minLength": 80 }
            }
          },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
          "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{24}$" },
          "consumedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "manualRecovery": { "type": "array", "items": { "type": "object" } },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "eventChainRoot", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{24}$" },
        "eventChainRoot": { "$ref": "#/$defs/ledgerHash" },
        "signature": { "type": "string", "minLength": 80 }
      }
    }
  },
  "$defs": {
    "canonicalHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ledgerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finality": {
      "type": "string",
      "enum": ["VERIFIED", "PROVIDER_ATTESTED", "INFERRED", "UNKNOWN", "DISPUTED"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "agentId", "agentVersion"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "agentVersion": { "type": "string", "minLength": 1 },
        "workloadId": { "type": "string" },
        "delegationChain": { "type": "array", "items": { "type": "string" }, "maxItems": 16 }
      }
    },
    "resourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "constraints": { "type": "object" }
      }
    },
    "actionState": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "PREFLIGHTING",
        "PREFLIGHT_REJECTED",
        "PREFLIGHTED",
        "AWAITING_APPROVAL",
        "ADMITTED",
        "SCHEDULED",
        "DISPATCHING",
        "OUTCOME_UNKNOWN",
        "RECONCILING",
        "PROVIDER_REJECTED",
        "REPORTED_SUCCEEDED",
        "VERIFYING",
        "VERIFIED_SUCCEEDED",
        "VERIFICATION_FAILED",
        "DRIFTED",
        "COMPENSATION_PLANNED",
        "COMPENSATING",
        "COMPENSATION_UNKNOWN",
        "COMPENSATION_RECONCILING",
        "COMPENSATION_REPORTED_SUCCEEDED",
        "COMPENSATION_VERIFYING",
        "VERIFIED_COMPENSATED",
        "COMPENSATION_BLOCKED",
        "COMPENSATION_FAILED",
        "WITHHELD",
        "RELEASING",
        "VERIFIED_RELEASED",
        "CANCELLED"
      ]
    }
  }
}
