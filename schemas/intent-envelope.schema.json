{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zerogate.dev/intent-envelope/1.0.0",
  "title": "ZeroGate Intent Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "environment", "actor", "purpose", "resourceScope", "limits", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["development", "test", "staging", "production"] },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "agentId", "agentVersion"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "agentVersion": { "type": "string", "minLength": 1 },
        "workloadId": { "type": "string" },
        "delegationChain": { "type": "array", "items": { "type": "string" }, "maxItems": 16 }
      }
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "resourceScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "constraints": { "type": "object" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxActions"],
      "properties": {
        "maxActions": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxExternalMessages": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maxSpend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      }
    },
    "notBefore": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
