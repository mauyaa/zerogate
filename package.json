{
  "name": "zerogate",
  "version": "0.5.1",
  "description": "Verified side-effect execution for TypeScript: reconcile lost responses, compensate safely, and verify signed receipts",
  "keywords": [
    "idempotency",
    "reconciliation",
    "transaction",
    "saga",
    "compensation",
    "side-effects",
    "receipts",
    "verification"
  ],
  "license": "Apache-2.0",
  "author": "mauyaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauyaa/zerogate.git"
  },
  "homepage": "https://zerogate-ashy.vercel.app",
  "bugs": {
    "url": "https://github.com/mauyaa/zerogate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./postgres": {
      "types": "./dist/src/postgres/event-ledger.d.ts",
      "default": "./dist/src/postgres/event-ledger.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "zerogate": "bin/zerogate.js"
  },
  "files": [
    "bin",
    "dist/src",
    "docs/README.md",
    "migrations",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node scripts/clean.mjs",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/*.test.js\"",
    "test:postgres": "tsc -p tsconfig.json && node --test \"dist/tests/postgres-event-ledger.test.js\"",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke-package.mjs",
    "prepack": "npm run build",
    "example": "tsc -p tsconfig.json && node dist/examples/rest-resource/run.js"
  },
  "peerDependencies": {
    "pg": "8.16.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.15.0",
    "@types/pg": "8.21.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.4",
    "pg": "8.23.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1"
  }
}
